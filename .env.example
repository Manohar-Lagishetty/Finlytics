# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (PostgreSQL) ---
DB_NAME=exp_pro
DB_USER=exp_pro
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- Email (SMTP) — used to send signup OTP codes ---
# FAKE/placeholder values. Replace with a real Gmail address + App Password
# (Google Account > Security > 2-Step Verification > App passwords), or any
# other SMTP provider's credentials.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-gmail-app-password"
DEFAULT_FROM_EMAIL="your-email@gmail.com"

# --- Google OAuth (Sign in with Google) ---
# FAKE/placeholder values. Create real ones at https://console.cloud.google.com
# > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorized redirect URI for local dev:
#   http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
